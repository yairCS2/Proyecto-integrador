coverage*.xml
coverage*.info
*.coverage
TestResult.xml

# ------------------------------------------------------------------------------
# NuGet
# ------------------------------------------------------------------------------
# NOTA: la carpeta DevyClass/packages/ SI se versiona a proposito.
# Es un proyecto .NET Framework (packages.config) y asi el proyecto compila
# sin necesidad de conexion a internet ni de ejecutar "nuget restore".
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/

# ------------------------------------------------------------------------------
# Librerias de UI de terceros (Guna.UI, Bunifu, Klik EntryLib)
# ------------------------------------------------------------------------------
# NOTA: la carpeta DevyClass/libs/ SI se versiona a proposito, para que el
# proyecto compile al clonarlo sin pasos extra. Son librerias comerciales.
*.nupkg.download
*.crack
*.patch
*.key
*.licx.bak

# ------------------------------------------------------------------------------
# Sistema operativo
# ------------------------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk

# ------------------------------------------------------------------------------
# Archivos temporales y de depuracion
# ------------------------------------------------------------------------------
*.tmp
*.log
*.bak
*.orig
*.old
*.rej
*~
*.swp
*.swo
.DS_Store
Thumbs.db
_ReSharper*/
